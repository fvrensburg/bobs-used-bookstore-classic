<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Bookstore.Web</RootNamespace>
    <AssemblyName>Bookstore.Web</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.CloudWatchLogs" Version="3.7.410.17" />
    <PackageReference Include="AWSSDK.SimpleSystemsManagement" Version="3.7.404.10" />
    <PackageReference Include="Autofac" Version="8.2.1" />
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="8.0.15" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.7.0" />
    <PackageReference Include="NLog" Version="5.4.0" />
    <PackageReference Include="NLog.Web.AspNetCore" Version="5.3.15" />
    <PackageReference Include="AWS.Logger.NLog" Version="3.3.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.14" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bookstore.Data\Bookstore.Data.csproj" />
    <ProjectReference Include="..\Bookstore.Common\Bookstore.Common.csproj" />
    <ProjectReference Include="..\Bookstore.Domain\Bookstore.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Remove web.config from content so it doesn't interfere -->
    <Content Remove="Web.config" />
    <Content Remove="Web.Debug.config" />
    <Content Remove="Web.Release.config" />
    <None Include="Web.config" />
    <None Include="Web.Debug.config" />
    <None Include="Web.Release.config" />
    <None Remove="Global.asax" />
    <Compile Remove="Global.asax.cs" />
    <!-- Remove old Views web.config files -->
    <Content Remove="Views\Web.config" />
    <Content Remove="Areas\Admin\Views\web.config" />
    <None Include="Views\Web.config" />
    <None Include="Areas\Admin\Views\web.config" />
    <!-- Remove old OWIN/MVC App_Start files - replaced by Program.cs -->
    <Compile Remove="App_Start\BundleConfig.cs" />
    <Compile Remove="App_Start\RouteConfig.cs" />
    <Compile Remove="App_Start\FilterConfig.cs" />
    <Compile Remove="App_Start\AuthenticationSetup.cs" />
    <Compile Remove="App_Start\DependencyInjectionSetup.cs" />
    <Compile Remove="App_Start\LoggingSetup.cs" />
    <Compile Remove="App_Start\ConfigurationSetup.cs" />
    <!-- Remove OWIN Startup.cs -->
    <Compile Remove="Startup.cs" />
    <!-- Remove old Properties\AssemblyInfo.cs -->
    <Compile Remove="Properties\AssemblyInfo.cs" />
  </ItemGroup>
</Project>
